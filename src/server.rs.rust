use std::env;
use std::io::{Read, Write};
use std::net::{TcpListener, TcpStream};
use std::str::from_utf8;
use std::thread;

const DEFAULT_ADDR: &str = "127.0.0.1:8080";

fn main() -> std::io::Result<()> {
    let addr = env::args()
        .nth(1)
        .unwrap_or_else(|| DEFAULT_ADDR.to_string());

    let listener = TcpListener::bind(&addr)?;
    eprintln!("listening on http://{addr}");

    for stream in listener.incoming() {
        let mut stream = stream?;
        thread::spawn(move || {
            if let Err(err) = handle_connection(&mut stream) {
                eprintln!("connection error: {err}");
            }
        });
    }
    Ok(())
}

struct Request<'a> {
    method: &'a str,
    path: &'a str,
    body: &'a [u8],
}

fn handle_connection(stream: &mut TcpStream) -> std::io::Result<()> {
    let raw = read_http_message(stream)?;
    let req = parse_request(&raw).ok_or_else(|| {
        std::io::Error::new(std::io::ErrorKind::InvalidData, "malformed HTTP request")
    })?;

    let (status, json) = route(req);
    write_json_response(stream, status, &json)
}

fn route(req: Request<'_>) -> (u16, String) {
    match (req.method, req.path) {
        ("GET", "/api/status") => (
            200,
            r#"{"ok":true,"service":"rust-std-http"}"#.to_string(),
        ),
        ("POST", "/api/echo") => match echo_with_patch(req.body) {
            Ok(json) => (200, json),
            Err(msg) => (400, msg),
        },
        ("GET", _) | ("POST", _) => (
            404,
            r#"{"error":"not_found"}"#.to_string(),
        ),
        _ => (
            405,
            r#"{"error":"method_not_allowed"}"#.to_string(),
        ),
    }
}

/// ورودی JSON ساده را می‌گیرد و همان ساختار را با یک فیلد اضافه برمی‌گرداند.
fn echo_with_patch(body: &[u8]) -> Result<String, String> {
    let text = from_utf8(body)
        .map_err(|_| r#"{"error":"body_must_be_utf8"}"#.to_string())?
        .trim();

    if text.is_empty() {
        return Err(r#"{"error":"empty_body"}"#.to_string());
    }

    let patched = append_processed_field(text)
        .map_err(|_| r#"{"error":"invalid_json_object"}"#.to_string())?;

    Ok(patched)
}

fn append_processed_field(input: &str) -> Result<String, ()> {
    let s = input.trim();
    if !s.starts_with('{') || !s.ends_with('}') {
        return Err(());
    }
    if s == "{}" {
        return Ok(r#"{"processed":true}"#.to_string());
    }
    // قبل از `}` بسته، فیلد جدید اضافه می‌کنیم (بدون parser کامل — برای JSON خیلی ساده کافی است)
    let prefix = &s[..s.len() - 1];
    Ok(format!(r#"{prefix},"processed":true}}"#))
}

fn read_http_message(stream: &mut TcpStream) -> std::io::Result<Vec<u8>> {
    let mut buf = Vec::with_capacity(4096);
    let mut chunk = [0u8; 1024];

    loop {
        let n = stream.read(&mut chunk)?;
        if n == 0 {
            break;
        }
        buf.extend_from_slice(&chunk[..n]);

        if let Some(header_end) = find_header_end(&buf) {
            let content_length = parse_content_length(&buf[..header_end])?;
            let body_start = header_end + 4;
            let total = body_start + content_length;
            while buf.len() < total {
                let n = stream.read(&mut chunk)?;
                if n == 0 {
                    break;
                }
                buf.extend_from_slice(&chunk[..n]);
            }
            buf.truncate(total.min(buf.len()));
            break;
        }

        if buf.len() > 64 * 1024 {
            return Err(std::io::Error::new(
                std::io::ErrorKind::InvalidData,
                "request too large",
            ));
        }
    }

    Ok(buf)
}

fn find_header_end(buf: &[u8]) -> Option<usize> {
    buf.windows(4).position(|w| w == b"\r\n\r\n")
}

fn parse_content_length(headers_bytes: &[u8]) -> std::io::Result<usize> {
    let headers = from_utf8(headers_bytes).map_err(|_| {
        std::io::Error::new(std::io::ErrorKind::InvalidData, "invalid header encoding")
    })?;

    for line in headers.lines() {
        let lower = line.to_ascii_lowercase();
        if let Some(val) = lower.strip_prefix("content-length:") {
            let n: usize = val.trim().parse().map_err(|_| {
                std::io::Error::new(std::io::ErrorKind::InvalidData, "bad content-length")
            })?;
            return Ok(n);
        }
    }
    Ok(0)
}

fn parse_request(raw: &[u8]) -> Option<Request<'_>> {
    let header_end = find_header_end(raw)?;
    let head = from_utf8(&raw[..header_end]).ok()?;
    let mut lines = head.lines();
    let request_line = lines.next()?;
    let mut parts = request_line.split_whitespace();
    let method = parts.next()?;
    let path = parts.next()?;
    let body = &raw[header_end + 4..];
    Some(Request { method, path, body })
}

fn write_json_response(stream: &mut TcpStream, status: u16, json: &str) -> std::io::Result<()> {
    let reason = match status {
        200 => "OK",
        400 => "Bad Request",
        404 => "Not Found",
        405 => "Method Not Allowed",
        _ => "Unknown",
    };

    let response = format!(
        "HTTP/1.1 {status} {reason}\r\n\
         Content-Type: application/json; charset=utf-8\r\n\
         Content-Length: {}\r\n\
         Connection: close\r\n\
         \r\n\
         {json}",
        json.len()
    );

    stream.write_all(response.as_bytes())?;
    stream.flush()
}
